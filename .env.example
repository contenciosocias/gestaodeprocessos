# ----------------------------------------------------------------------------
# Variáveis do FRONT-END (Vite). Copie para `.env` no desenvolvimento local.
# Estes valores vão embutidos no bundle estático e são PÚBLICOS por natureza.
# A anon key do Supabase é pública — ver a seção "Segurança" do README.
# ----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Base path do GitHub Pages. Em dev deixe vazio ('/').
# Em produção o workflow injeta /<nome-do-repo>/ automaticamente.
# VITE_BASE=/contencioso-cias/
